    dynamicAction facets-changed (
        name: facets changed
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: apexafterrefresh
            selectionType: region
            region: @all-notes
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @timeline
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @by-requisition
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @notes
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    process add-app-note (
        name: ADD_APP_NOTE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_app_id    NUMBER         := TO_NUMBER(apex_application.g_x01);
                    l_note_text VARCHAR2(4000) := SUBSTRB(apex_application.g_x02, 1, 4000);
                BEGIN
                    INSERT INTO candidate_note (job_application_id, note_text, created_by)
                    VALUES (l_app_id, l_note_text,
                            COALESCE(SYS_CONTEXT('APEX$SESSION','APP_USER'), USER));
                
                    apex_json.open_object;
                    apex_json.write('status', 'OK');
                    apex_json.close_object;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_json.open_object;
                        apex_json.write('status',  'ERROR');
                        apex_json.write('message', SQLERRM);
                        apex_json.close_object;
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 35000502
        }
    )

    process add-person-note (
        name: ADD_PERSON_NOTE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_person_id NUMBER         := TO_NUMBER(apex_application.g_x01);
                    l_note_text VARCHAR2(4000) := SUBSTRB(apex_application.g_x02, 1, 4000);
                BEGIN
                    INSERT INTO applicant_note (person_id, note_text, created_by)
                    VALUES (l_person_id, l_note_text,
                            COALESCE(SYS_CONTEXT('APEX$SESSION','APP_USER'), USER));
                
                    apex_json.open_object;
                    apex_json.write('status', 'OK');
                    apex_json.close_object;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_json.open_object;
                        apex_json.write('status',  'ERROR');
                        apex_json.write('message', SQLERRM);
                        apex_json.close_object;
                END;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 35000503
        }
    )

    process get-candidate-notes-all (
        name: GET_CANDIDATE_NOTES_ALL
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_person_id NUMBER := TO_NUMBER(apex_application.g_x01);
                BEGIN
                    apex_json.open_object;
                    apex_json.open_array('notes');
                
                    FOR r IN (
                        SELECT n.note_id,
                               n.NOTE_TYPE,
                               n.note_text,
                               n.created_by,
                               TO_CHAR(n.created_on, 'DD-Mon-YYYY HH24:MI') AS created_on,
                               n.REQ_NUMBER,
                               n.REQUISITION_TITLE,
                               n.APPLICATION_PHASE,
                               n.APPLICATION_STATE,
                               n.job_application_id
                          FROM NOTES_TIMELINE_V n
                         WHERE n.person_id = l_person_id
                         ORDER BY n.created_on DESC
                    ) LOOP
                        apex_json.open_object;
                        apex_json.write('note_id',           r.note_id);
                        apex_json.write('note_type',         r.NOTE_TYPE);
                        apex_json.write('note_text',         r.note_text);
                        apex_json.write('created_by',        r.created_by);
                        apex_json.write('created_on',        r.created_on);
                        apex_json.write('req_number',        r.REQ_NUMBER);
                        apex_json.write('requisition_title', r.REQUISITION_TITLE);
                        apex_json.write('app_phase',         r.APPLICATION_PHASE);
                        apex_json.write('app_state',         r.APPLICATION_STATE);
                        apex_json.write('job_app_id',        r.job_application_id);
                        apex_json.close_object;
                    END LOOP;
                
                    apex_json.close_array;
                    apex_json.close_object;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_json.open_object;
                        apex_json.write('status',  'ERROR');
                        apex_json.write('message', SQLERRM);
                        apex_json.close_object;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 35000501
        }
    )

    process get-req-tree (
        name: GET_REQ_TREE
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_prev_req   VARCHAR2(100) := CHR(0);
                    l_prev_app   NUMBER        := -1;
                    l_note_count PLS_INTEGER   := 0;
                    l_app_count  PLS_INTEGER   := 0;
                    l_req_notes  PLS_INTEGER   := 0;
                BEGIN
                    apex_json.open_object;
                    apex_json.open_array('reqs');
                
                    FOR r IN (
                        WITH filtered_notes AS (
                            SELECT note_id, note_type, note_text, created_by,
                                   job_application_id, person_id, candidate_name,
                                   req_number, requisition_title, application_phase, application_state
                              FROM TABLE(get_faceted_notes_data(35, 'notes_report'))
                        ),
                        latest_app AS (
                            SELECT a.JOBAPPLICATIONID, a.CANDIDATEPERSONID, a.CANDIDATENAME,
                                   a.REQUISITIONNUMBER, a.REQUISITIONID,
                                   a.PHASENAME, a.STATENAME,
                                   ROW_NUMBER() OVER (PARTITION BY a.JOBAPPLICATIONID
                                                      ORDER BY a."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                              FROM JOB_APPLICANTS_R a
                        ),
                        latest_req AS (
                            SELECT r.REQUISITIONID, r.REQUISITIONNUMBER, r.TITLE,
                                   r.PHASENAME, r.STATENAME,
                                   ROW_NUMBER() OVER (PARTITION BY r.REQUISITIONID
                                                      ORDER BY r."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                              FROM JOB_REQUISITIONS_R r
                        ),
                        tree_data AS (
                            ---------------------------------------------------------------
                            -- APPLICATION notes: already have req/app context from the view
                            ---------------------------------------------------------------
                            SELECT fn.req_number,
                                   fn.job_application_id, fn.candidate_name, fn.person_id,
                                   fn.application_phase AS app_phase,
                                   fn.application_state AS app_state,
                                   fn.note_id, fn.note_type, fn.note_text,
                                   fn.created_by
                              FROM filtered_notes fn
                             WHERE fn.note_type = 'APPLICATION'
                               AND fn.req_number IS NOT NULL
                
                            UNION ALL
                
                            ---------------------------------------------------------------
                            -- PERSON notes: place under each of the person's applications
                            ---------------------------------------------------------------
                            SELECT la.REQUISITIONNUMBER,
                                   la.JOBAPPLICATIONID, la.CANDIDATENAME, fn.person_id,
                                   la.PHASENAME, la.STATENAME,
                                   fn.note_id, fn.note_type, fn.note_text,
                                   fn.created_by
                              FROM filtered_notes fn
                              JOIN latest_app la
                                ON la.CANDIDATEPERSONID = fn.person_id AND la.rn = 1
                             WHERE fn.note_type = 'PERSON'
                               AND la.REQUISITIONNUMBER IS NOT NULL
                        )
                        ---------------------------------------------------------------
                        -- Final SELECT: add req-level title/phase/state from requisitions
                        ---------------------------------------------------------------
                        SELECT td.req_number,
                               lr.TITLE           AS requisition_title,
                               lr.PHASENAME       AS req_phase,
                               lr.STATENAME       AS req_state,
                               td.job_application_id,
                               td.candidate_name,
                               td.person_id,
                               td.app_phase,
                               td.app_state,
                               td.note_id,
                               td.note_type,
                               td.note_text,
                               td.created_by
                          FROM tree_data td
                          LEFT JOIN latest_req lr
                            ON lr.REQUISITIONNUMBER = td.req_number AND lr.rn = 1
                         ORDER BY td.req_number,
                                  td.candidate_name,
                                  td.job_application_id,
                                  DECODE(td.note_type, 'APPLICATION', 1, 2),
                                  td.note_id DESC
                    ) LOOP
                        --=================================================================
                        -- Break on req_number → open/close requisition level
                        --=================================================================
                        IF l_prev_req = CHR(0) OR r.req_number != l_prev_req THEN
                            -- Close previous application + requisition (if not first row)
                            IF l_prev_req != CHR(0) THEN
                                apex_json.close_array;                     -- /notes
                                apex_json.write('note_count', l_note_count);
                                apex_json.close_object;                    -- /app
                                apex_json.close_array;                     -- /apps
                                apex_json.write('app_count',  l_app_count);
                                apex_json.write('note_count', l_req_notes);
                                apex_json.close_object;                    -- /req
                            END IF;
                
                            apex_json.open_object;
                            apex_json.write('req_number', r.req_number);
                            apex_json.write('title',      r.requisition_title);
                            apex_json.write('phase',      r.req_phase);
                            apex_json.write('state',      r.req_state);
                            apex_json.open_array('apps');
                
                            l_prev_req  := r.req_number;
                            l_prev_app  := -1;
                            l_app_count := 0;
                            l_req_notes := 0;
                        END IF;
                
                        --=================================================================
                        -- Break on job_application_id → open/close application level
                        --=================================================================
                        IF l_prev_app = -1 OR r.job_application_id != l_prev_app THEN
                            IF l_prev_app != -1 THEN
                                apex_json.close_array;                     -- /notes
                                apex_json.write('note_count', l_note_count);
                                apex_json.close_object;                    -- /app
                            END IF;
                
                            apex_json.open_object;
                            apex_json.write('app_id',         r.job_application_id);
                            apex_json.write('candidate_name', r.candidate_name);
                            apex_json.write('person_id',      r.person_id);
                            apex_json.write('phase',          r.app_phase);
                            apex_json.write('state',          r.app_state);
                            apex_json.open_array('notes');
                
                            l_prev_app   := r.job_application_id;
                            l_note_count := 0;
                            l_app_count  := l_app_count + 1;
                        END IF;
                
                        --=================================================================
                        -- Write each note
                        --=================================================================
                        apex_json.open_object;
                        apex_json.write('note_id',    r.note_id);
                        apex_json.write('note_type',  r.note_type);
                        apex_json.write('note_text',  r.note_text);
                        apex_json.write('created_by', r.created_by);
                        apex_json.close_object;
                        l_note_count := l_note_count + 1;
                        l_req_notes  := l_req_notes + 1;
                    END LOOP;
                
                    -- Close the last application + requisition (if any rows were processed)
                    IF l_prev_req != CHR(0) THEN
                        apex_json.close_array;                             -- /notes
                        apex_json.write('note_count', l_note_count);
                        apex_json.close_object;                            -- /app
                        apex_json.close_array;                             -- /apps
                        apex_json.write('app_count',  l_app_count);
                        apex_json.write('note_count', l_req_notes);
                        apex_json.close_object;                            -- /req
                    END IF;
                
                    apex_json.close_array;                                 -- /reqs
                    apex_json.close_object;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_json.initialize_output;
                        apex_json.open_object;
                        apex_json.write('status',  'ERROR');
                        apex_json.write('message', SQLERRM);
                        apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 50
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 35000505
        }
    )

    process search-candidates (
        name: SEARCH_CANDIDATES
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_search VARCHAR2(200) := '%' || UPPER(TRIM(apex_application.g_x01)) || '%';
                BEGIN
                    apex_json.open_object;
                    apex_json.open_array('results');
                
                    FOR r IN (
                        WITH la AS (
                            SELECT app.CANDIDATEPERSONID   AS person_id,
                                   app.JOBAPPLICATIONID    AS job_application_id,
                                   app.CANDIDATENAME       AS candidate_name,
                                   app.REQUISITIONNUMBER   AS req_number,
                                   app.REQUISITIONID,
                                   app.PHASENAME           AS phase,
                                   ROW_NUMBER() OVER (PARTITION BY app.JOBAPPLICATIONID
                                                      ORDER BY app."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                              FROM JOB_APPLICANTS_R app
                             WHERE UPPER(app.CANDIDATENAME)   LIKE l_search
                                OR app.REQUISITIONNUMBER      LIKE l_search
                        ),
                        lr AS (
                            SELECT r.REQUISITIONID, r.TITLE,
                                   ROW_NUMBER() OVER (PARTITION BY r.REQUISITIONID
                                                      ORDER BY r."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                              FROM JOB_REQUISITIONS_R r
                        ),
                        lc AS (
                            SELECT c.PERSONID, c.CANDIDATENUMBER,
                                   ROW_NUMBER() OVER (PARTITION BY c.PERSONID
                                                      ORDER BY c."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                              FROM RECRUITING_CANDIDATES_R c
                        )
                        SELECT la.person_id, la.job_application_id, la.candidate_name,
                               la.req_number, lr.TITLE AS req_title, la.phase,
                               lc.CANDIDATENUMBER AS candidate_number
                          FROM la
                          LEFT JOIN lr ON lr.REQUISITIONID = la.REQUISITIONID AND lr.rn = 1
                          LEFT JOIN lc ON lc.PERSONID = la.person_id AND lc.rn = 1
                         WHERE la.rn = 1
                         FETCH FIRST 20 ROWS ONLY
                    ) LOOP
                        apex_json.open_object;
                        apex_json.write('person_id',          r.person_id);
                        apex_json.write('job_application_id', r.job_application_id);
                        apex_json.write('candidate_name',     r.candidate_name);
                        apex_json.write('candidate_number',   r.candidate_number);
                        apex_json.write('req_number',         r.req_number);
                        apex_json.write('req_title',          r.req_title);
                        apex_json.write('phase',              r.phase);
                        apex_json.close_object;
                    END LOOP;
                
                    apex_json.close_array;
                    apex_json.close_object;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        apex_json.open_object;
                        apex_json.write('status',  'ERROR');
                        apex_json.write('message', SQLERRM);
                        apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 40
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 35000504
        }
    )

)

