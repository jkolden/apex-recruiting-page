    region notes (
        name: Notes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                WITH filtered AS (
                    SELECT note_id, note_type, note_text, created_by, created_on,
                           job_application_id, person_id, candidate_name,
                           req_number, requisition_title, application_phase, application_state
                      FROM TABLE(get_faceted_notes_data_v2(35, 'notes_report'))
                ),
                filtered_persons AS (
                    SELECT person_id,
                           MAX(candidate_name) AS candidate_name
                      FROM filtered
                     WHERE person_id IS NOT NULL
                     GROUP BY person_id
                ),
                filtered_reqs AS (
                    SELECT DISTINCT req_number
                      FROM filtered
                     WHERE req_number IS NOT NULL
                ),
                latest_app AS (
                    SELECT a.JOBAPPLICATIONID, a.CANDIDATEPERSONID,
                           a.CANDIDATENAME, a.REQUISITIONNUMBER, a.REQUISITIONID,
                           a.PHASENAME, a.STATENAME,
                           ROW_NUMBER() OVER (PARTITION BY a.JOBAPPLICATIONID
                                              ORDER BY a."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                      FROM JOB_APPLICANTS_R a
                ),
                latest_req AS (
                    SELECT r.REQUISITIONID, r.REQUISITIONNUMBER, r.TITLE,
                           r.PHASENAME AS REQ_PHASE, r.STATENAME AS REQ_STATE,
                           ROW_NUMBER() OVER (PARTITION BY r.REQUISITIONID
                                              ORDER BY r."APEX$ROW_SYNC_TIMESTAMP" DESC) AS rn
                      FROM JOB_REQUISITIONS_R r
                ),
                base AS (
                    -------------------------------------------------------------------
                    -- APPLICATION notes: from facet-filtered results + req phase/state
                    -------------------------------------------------------------------
                    SELECT fn.note_id, fn.note_type, fn.note_text, fn.created_by, fn.created_on,
                           fn.candidate_name, fn.req_number, fn.requisition_title,
                           fn.application_phase, fn.application_state,
                           lr.REQ_PHASE, lr.REQ_STATE,
                           fn.req_number || ' — ' || NVL(fn.requisition_title, 'Untitled') AS req_group
                      FROM filtered fn
                      LEFT JOIN latest_req lr
                        ON lr.REQUISITIONNUMBER = fn.req_number AND lr.rn = 1
                     WHERE fn.note_type = 'APPLICATION'
                       AND fn.req_number IS NOT NULL
                
                    UNION ALL
                
                    -------------------------------------------------------------------
                    -- PERSON notes: only for candidates AND reqs in the filtered set
                    -------------------------------------------------------------------
                    SELECT an.note_id, 'PERSON' AS note_type, an.note_text,
                           LOWER(an.created_by) AS created_by, an.created_on,
                           fp.candidate_name,
                           la.REQUISITIONNUMBER AS req_number,
                           lr.TITLE             AS requisition_title,
                           la.PHASENAME         AS application_phase,
                           la.STATENAME         AS application_state,
                           lr.REQ_PHASE, lr.REQ_STATE,
                           la.REQUISITIONNUMBER || ' — ' || NVL(lr.TITLE, 'Untitled') AS req_group
                      FROM applicant_note an
                      JOIN filtered_persons fp
                        ON fp.person_id = an.person_id
                      JOIN latest_app la
                        ON la.CANDIDATEPERSONID = an.person_id AND la.rn = 1
                      JOIN filtered_reqs fr
                        ON fr.req_number = la.REQUISITIONNUMBER
                      LEFT JOIN latest_req lr
                        ON lr.REQUISITIONID = la.REQUISITIONID AND lr.rn = 1
                ),
                enriched AS (
                    SELECT b.*,
                        MAX(CASE WHEN note_type = 'APPLICATION' THEN application_phase END)
                            OVER (PARTITION BY req_group, candidate_name) AS cand_phase,
                        MAX(CASE WHEN note_type = 'APPLICATION' THEN application_state END)
                            OVER (PARTITION BY req_group, candidate_name) AS cand_state
                    FROM base b
                ),
                ordered AS (
                    SELECT
                        e.*,
                        LAG(e.req_group) OVER (
                            ORDER BY e.req_number, e.candidate_name,
                                DECODE(e.note_type, 'APPLICATION', 1, 2),
                                e.created_on DESC
                        ) AS prev_group,
                        LAG(e.candidate_name) OVER (
                            ORDER BY e.req_number, e.candidate_name,
                                DECODE(e.note_type, 'APPLICATION', 1, 2),
                                e.created_on DESC
                        ) AS prev_candidate,
                        LEAD(e.req_group) OVER (
                            ORDER BY e.req_number, e.candidate_name,
                                DECODE(e.note_type, 'APPLICATION', 1, 2),
                                e.created_on DESC
                        ) AS next_group
                    FROM enriched e
                )
                SELECT
                    /* ---- req group header (when req changes) ---- */
                    CASE
                        WHEN prev_group IS NULL OR prev_group != req_group THEN
                            '<div class="nhub-rc-hdr">'
                            || '<span class="fa fa-briefcase nhub-rc-hdr-icon"></span> '
                            || APEX_ESCAPE.HTML(req_group)
                            || CASE WHEN req_phase IS NOT NULL THEN
                                ' <span class="nhub-pill nhub-pill--sm">'
                                || APEX_ESCAPE.HTML(req_phase) || '</span>' ELSE '' END
                            || CASE WHEN req_state IS NOT NULL THEN
                                ' <span class="nhub-pill nhub-pill--sm">'
                                || APEX_ESCAPE.HTML(req_state) || '</span>' ELSE '' END
                            || '</div>'
                        ELSE ''
                    END
                    /* ---- candidate sub-header (when candidate changes within group) ---- */
                    || CASE
                        WHEN prev_group IS NULL OR prev_group != req_group
                          OR prev_candidate IS NULL OR prev_candidate != candidate_name THEN
                            '<div class="nhub-ne-cand-hdr">'
                            || '<span class="fa fa-user nhub-ne-cand-hdr-icon"></span> '
                            || '<strong>' || APEX_ESCAPE.HTML(candidate_name) || '</strong>'
                            || CASE WHEN cand_phase IS NOT NULL THEN
                                ' <span class="nhub-pill nhub-pill--sm">'
                                || APEX_ESCAPE.HTML(cand_phase) || '</span>' ELSE '' END
                            || CASE WHEN cand_state IS NOT NULL THEN
                                ' <span class="nhub-pill nhub-pill--sm">'
                                || APEX_ESCAPE.HTML(cand_state) || '</span>' ELSE '' END
                            || '<span class="fa fa-chevron-down nhub-ne-cand-toggle"></span>'
                            || '</div>'
                        ELSE ''
                    END
                    /* ---- note entry ---- */
                    || '<div class="nhub-ne nhub-ne--' || LOWER(note_type)
                    || CASE WHEN next_group IS NULL OR next_group != req_group
                            THEN ' nhub-ne--last' ELSE '' END
                    || '">'
                    || '<div class="nhub-ne-head">'
                    || '<span class="nhub-tl-type-badge">' || note_type || '</span> '
                    || '<span class="nhub-ne-meta">'
                        || APEX_ESCAPE.HTML(created_by)
                        || ' &middot; '
                        || TO_CHAR(created_on, 'DD-Mon-YYYY HH24:MI')
                    || '</span>'
                    || '</div>'
                    || '<div class="nhub-ne-text">'
                        || APEX_ESCAPE.HTML(note_text) || '</div>'
                    || '</div>' AS NOTE_DISPLAY
                FROM ordered
                ORDER BY
                    req_number, candidate_name,
                    DECODE(note_type, 'APPLICATION', 1, 2),
                    created_on DESC
                
                ```
            pageItemsToSubmit: [
                P35_NOTE_TYPE
                P35_CREATED_BY
                P35_CANDIDATE_NAME
                P35_REQ_NUMBER
                P35_APP_PHASE
                P35_SEARCH
            ]
        }
        layout {
            sequence: 5
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: req_cards
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }

        column NOTE_DISPLAY (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Note Display
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
            advanced {
                cellWidth: 900
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

