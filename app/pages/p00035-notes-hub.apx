page 35 (
    name: Notes Hub
    alias: NOTES-HUB
    title: Notes Hub
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: [
            #APP_FILES#notes_hub_js#MIN#.js
            #APP_FILES#notes_hub_js_v2.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#notes_hub_css#MIN#.css
            #APP_FILES#notes_hub_css_v2.css
        ]
        inline:
            ```css
            .t-Region-header {display: none;}
            
            #t_Button_navControl {
                display: none !important;
            }
            /* Breadcrumb container */
            #gps-breadcrumb {
              background: #fff;
              border: 0;
              border-bottom: 1px solid #dfe6e2;
              box-shadow: none;
            }
            
            #gps-breadcrumb .t-ButtonRegion-wrap {
              min-height: auto;
              padding: 10px 24px;
            }
            
            /* Remove unused columns */
            #gps-breadcrumb .t-ButtonRegion-col--left,
            #gps-breadcrumb .t-ButtonRegion-col--right {
              display: none;
            }
            
            /* Breadcrumb layout */
            #gps-breadcrumb .t-Breadcrumb {
              margin: 0;
              padding: 0;
            }
            
            /* Home link */
            #gps-breadcrumb .t-Breadcrumb-item a.t-Breadcrumb-label,
            #gps-breadcrumb .t-Breadcrumb-item a.t-Breadcrumb-label:visited {
              color: #315c45;
              font-size: 0.9375rem;
              font-weight: 600;
              text-decoration: none;
            }
            
            #gps-breadcrumb .t-Breadcrumb-item a.t-Breadcrumb-label:hover {
              color: #244735;
              text-decoration: underline;
            }
            
            /* Current page */
            #gps-breadcrumb .t-Breadcrumb-item.is-active .t-Breadcrumb-label {
              margin: 0;
              color: #1f2933;
              font-size: 0.9375rem;
              font-weight: 700;
              line-height: 1.4;
            }
            
            /* Divider between breadcrumb items */
            #gps-breadcrumb .t-Breadcrumb-item::after {
              color: #a5afa9;
              font-weight: 400;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region all-notes (
        name: All Notes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    note_id,
                    NOTE_TYPE,
                    note_text,
                    created_by,
                    created_on,
                    job_application_id,
                    person_id,
                    CANDIDATE_NAME,
                    CANDIDATE_NUMBER,
                    CANDIDATE_EMAIL,
                    REQ_NUMBER,
                    REQUISITION_TITLE,
                    APPLICATION_PHASE,
                    APPLICATION_STATE,
                    CASE NOTE_TYPE
                        WHEN 'APPLICATION' THEN 'fa-file-text-o'
                        WHEN 'PERSON'      THEN 'fa-user'
                    END AS NOTE_TYPE_ICON,
                    TO_CHAR(created_on, 'DD-Mon-YYYY HH24:MI') AS CREATED_ON_FMT
                FROM NOTES_TIMELINE_V
                ORDER BY CREATED_ON DESC
                ```
            pageItemsToSubmit: P35_REQUISITION_TITLE
        }
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: notes_report
            regionDisplaySelector: true
        }
        reportLayout {
            numberOfRows: 50
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--hideNoPagination
            ]
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No notes found.
        }

        column APPLICATION_PHASE (
            reportColumnQueryId: 13
            derivedColumn: N
            heading {
                heading: Phase
            }
            layout {
                sequence: 18
            }
        )

        column APPLICATION_STATE (
            reportColumnQueryId: 14
            derivedColumn: N
            type: hidden
            layout {
                sequence: 15
            }
        )

        column CANDIDATE_EMAIL (
