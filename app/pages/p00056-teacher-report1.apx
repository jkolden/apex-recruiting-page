    pageItem P56_STATE_ID (
        type: selectList
        label {
            label: New State
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select distinct
                       rs.state_name  d,
                       s.state_id     r
                from   irc_routing_steps_stg  p
                join   irc_routing_steps_stg  s
                       on  s.process_id = p.sub_process_id
                       and s.type_code  = 'STATE'
                join   rec_routing_state  rs
                       on  rs.state_id = s.state_id
                where  p.phase_id  = :P56_PHASE_ID
                and    p.type_code = 'PHASE'
                order  by rs.state_name
                
                
                ```
            nullDisplayValue: -- Select State --
        }
        cascadingLov {
            parentItems: [
                P56_CURRENT_PHASE
                P56_PHASE_ID
            ]
        }
        layout {
            sequence: 60
            region: @move-applicant
            slot: regionBody
            alignment: left
            columnSpan: 12
        }
    )

