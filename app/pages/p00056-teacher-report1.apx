            }
            #reflink_backdrop {
                position: fixed;
                top: 0; left: 0;
                width: 100%; height: 100%;
                background: rgba(0,0,0,0.4);
                z-index: 1005;
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.35s ease;
