page 4004 (
    name: Reference Answers
    alias: REFERENCE-ANSWERS
    title: Reference Answers
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1100
        height: 640
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            td[headers="REF_1_ANSWER"],
            td[headers="REF_2_ANSWER"],
            td[headers="REF_3_ANSWER"] {
                font-size: 1.2em;
                letter-spacing: 2px;
            }
            
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reference-answers (
        name: Reference Answers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT QUESTION,
                       REF_1_NAME,
                       CASE 
                         WHEN REF_1_ANSWER = '1' THEN '★☆☆☆☆'
                         WHEN REF_1_ANSWER = '2' THEN '★★☆☆☆'
                         WHEN REF_1_ANSWER = '3' THEN '★★★☆☆'
                         WHEN REF_1_ANSWER = '4' THEN '★★★★☆'
                         WHEN REF_1_ANSWER = '5' THEN '★★★★★'
                         ELSE REF_1_ANSWER
                       END AS REF_1_ANSWER,
                       REF_2_NAME,
                       CASE 
                         WHEN REF_2_ANSWER = '1' THEN '★☆☆☆☆'
                         WHEN REF_2_ANSWER = '2' THEN '★★☆☆☆'
                         WHEN REF_2_ANSWER = '3' THEN '★★★☆☆'
                         WHEN REF_2_ANSWER = '4' THEN '★★★★☆'
                         WHEN REF_2_ANSWER = '5' THEN '★★★★★'
                         ELSE REF_2_ANSWER
                       END AS REF_2_ANSWER,
                       REF_3_NAME,
                       CASE 
                         WHEN REF_3_ANSWER = '1' THEN '★☆☆☆☆'
                         WHEN REF_3_ANSWER = '2' THEN '★★☆☆☆'
                         WHEN REF_3_ANSWER = '3' THEN '★★★☆☆'
                         WHEN REF_3_ANSWER = '4' THEN '★★★★☆'
                         WHEN REF_3_ANSWER = '5' THEN '★★★★★'
                         ELSE REF_3_ANSWER
                       END AS REF_3_ANSWER
                FROM HRD2_SURVEY_PIVOT_V
                WHERE PERSON_ID = (SELECT CANDIDATEPERSONID
                                   FROM JOB_APPLICANTS_R
                                   WHERE JOBAPPLICATIONID = :P4004_JOB_APPLICATION_ID
                                   AND ROWNUM = 1)
                
                ORDER BY QUESTION
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
            whenMoreDataFound: The maximum row count for this report is #MAX_ROW_COUNT# rows.  Please apply a filter to reduce the number of records in your query.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            rowsPerPage: false
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 109531229525112986
        }

        column QUESTION (
            type: plainText
            heading {
                heading: Question
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column REF_1_ANSWER (
            type: plainText
            heading {
                heading: &P4004_REF_1_NAME.
                alignment: center
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: REF_1_ANSWER
                endUserAlias: C
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P4004_REF_1_NAME
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REF_1_NAME (
            type: hidden
            heading {
                heading: Ref 1 Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P4004_REF_1_NAME
            }
        )

        column REF_2_ANSWER (
            type: plainText
            heading {
                heading: &P4004_REF_2_NAME.
                alignment: center
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: REF_2_ANSWER
                endUserAlias: E
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P4004_REF_2_NAME
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REF_2_NAME (
            type: hidden
            heading {
                heading: Ref 2 Name
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P4004_REF_2_NAME
            }
        )

        column REF_3_ANSWER (
            type: plainText
            heading {
                heading: &P4004_REF_3_NAME.
                alignment: center
            }
            layout {
                sequence: 7
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: REF_3_ANSWER
                endUserAlias: G
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P4004_REF_3_NAME
            }
            security {
                escapeSpecialChars: false
            }
        )

        column REF_3_NAME (
            type: hidden
            heading {
                heading: Ref 3 Name
            }
            layout {
                sequence: 6
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
            serverSideCondition {
                type: itemIsNotNull
                item: P4004_REF_3_NAME
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
        pageHeader {
            pageHeaderText: Reference Answers
        }

        savedReport 1095359 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn QUESTION (
                sequence: 1
            )

            displayColumn REF_1_ANSWER (
                sequence: 3
            )

            displayColumn REF_1_NAME (
                sequence: 2
            )

            displayColumn REF_2_ANSWER (
                sequence: 5
            )

            displayColumn REF_2_NAME (
                sequence: 4
            )

            displayColumn REF_3_ANSWER (
                sequence: 7
            )

            displayColumn REF_3_NAME (
                sequence: 6
            )

        )

    )

    pageItem P4004_JOB_APPLICATION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @reference-answers
            slot: regionBody
        }
    )

    pageItem P4004_REF_1_NAME (
        type: hidden
        layout {
            sequence: 20
            region: @reference-answers
            slot: regionBody
        }
    )

    pageItem P4004_REF_2_NAME (
        type: hidden
        layout {
            sequence: 30
            region: @reference-answers
            slot: regionBody
        }
    )

    pageItem P4004_REF_3_NAME (
        type: hidden
        layout {
            sequence: 40
            region: @reference-answers
            slot: regionBody
        }
    )

    process fetch-reference-names (
        name: fetch reference names
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                SELECT MAX(REF_1_NAME), MAX(REF_2_NAME), MAX(REF_3_NAME)
                INTO :P4004_REF_1_NAME, :P4004_REF_2_NAME, :P4004_REF_3_NAME
                FROM HRD2_SURVEY_PIVOT_V
                WHERE PERSON_ID = (SELECT CANDIDATEPERSONID
                                   FROM JOB_APPLICANTS_R
                                   WHERE JOBAPPLICATIONID = :P4004_JOB_APPLICATION_ID
                                   AND ROWNUM = 1)
                AND ROWNUM = 1;
                
                
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 108872383895948437
        }
    )

)

