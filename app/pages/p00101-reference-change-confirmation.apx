page 101 (
    name: Reference Change Confirmation
    alias: REFERENCE-CHANGE-CONFIRMATION
    title: Reference Change Confirmation
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .chg-Y {
               border-left: 3px solid #16a34a;
            background: #f0fdf4;
            padding: 2px 8px;
            font-weight: 600;
            color: #166534;
            
            }
            .chg-Y::after {
                content: ' \2713';
                font-size: 11px;
            }
            
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region changes-report (
        name: changes report
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                WITH qstnr AS (
                    SELECT
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_REF_EXT_NAME1'   THEN ANSWER_TEXT END) AS r1n,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_PHONE1'  THEN ANSWER_TEXT END) AS r1p,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_REF_EXT_EMAIL1'  THEN ANSWER_TEXT END) AS r1e,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_NAME2'   THEN ANSWER_TEXT END) AS r2n,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_PHONE2'  THEN ANSWER_TEXT END) AS r2p,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_EMAIL2'  THEN ANSWER_TEXT END) AS r2e,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_NAME3'   THEN ANSWER_TEXT END) AS r3n,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_PHONE3'  THEN ANSWER_TEXT END) AS r3p,
                        MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_EMAIL3'  THEN ANSWER_TEXT END) AS r3e
                    FROM FBX_QSTNR_V
                    WHERE SUBJECT_ID = :P100_JOB_APPLICATION_ID
                      AND QUESTION_CODE IN (
                          'GCS_REF_EXT_NAME1','GCS_EXT_REF_PHONE1','GCS_REF_EXT_EMAIL1',
                          'GCS_EXT_REF_NAME2','GCS_EXT_REF_PHONE2','GCS_EXT_REF_EMAIL2',
                          'GCS_EXT_REF_NAME3','GCS_EXT_REF_PHONE3','GCS_EXT_REF_EMAIL3'
                      )
                ),
                orig AS (
                    SELECT
                        COALESCE(rc.ref_1_name,  q.r1n)            AS r1n,
                        fmt_phone(COALESCE(rc.ref_1_phone, q.r1p)) AS r1p,
                        LOWER(TRIM(COALESCE(rc.ref_1_email, q.r1e))) AS r1e,
                        COALESCE(rc.ref_2_name,  q.r2n)            AS r2n,
                        fmt_phone(COALESCE(rc.ref_2_phone, q.r2p)) AS r2p,
                        LOWER(TRIM(COALESCE(rc.ref_2_email, q.r2e))) AS r2e,
                        COALESCE(rc.ref_3_name,  q.r3n)            AS r3n,
                        fmt_phone(COALESCE(rc.ref_3_phone, q.r3p)) AS r3p,
                        LOWER(TRIM(COALESCE(rc.ref_3_email, q.r3e))) AS r3e
                    FROM qstnr q
                    LEFT JOIN ref_correction rc
                           ON rc.job_application_id = :P100_JOB_APPLICATION_ID
                )
                SELECT
                    rn,
                    field_name,
                    current_value,
                    new_value,
                    CASE WHEN NVL(current_value, CHR(0)) != NVL(new_value, CHR(0))
                         THEN 'Y' ELSE 'N'
                    END AS changed_yn
                FROM (
                    SELECT 1 AS rn, 'Reference 1 - Name'  AS field_name, r1n AS current_value, :P100_REF_1_NAME                   AS new_value FROM orig UNION ALL
                    SELECT 2,       'Reference 1 - Phone',               r1p,                  fmt_phone(:P100_REF_1_PHONE)                    FROM orig UNION ALL
                    SELECT 3,       'Reference 1 - Email',               r1e,                  LOWER(TRIM(:P100_REF_1_EMAIL))                  FROM orig UNION ALL
                    SELECT 4,       'Reference 2 - Name',                r2n,                  :P100_REF_2_NAME                                FROM orig UNION ALL
                    SELECT 5,       'Reference 2 - Phone',               r2p,                  fmt_phone(:P100_REF_2_PHONE)                    FROM orig UNION ALL
                    SELECT 6,       'Reference 2 - Email',               r2e,                  LOWER(TRIM(:P100_REF_2_EMAIL))                  FROM orig UNION ALL
                    SELECT 7,       'Reference 3 - Name',                r3n,                  :P100_REF_3_NAME                                FROM orig UNION ALL
                    SELECT 8,       'Reference 3 - Phone',               r3p,                  fmt_phone(:P100_REF_3_PHONE)                    FROM orig UNION ALL
                    SELECT 9,       'Reference 3 - Email',               r3e,                  LOWER(TRIM(:P100_REF_3_EMAIL))                  FROM orig
                )
                ORDER BY rn
                
                ```
            pageItemsToSubmit: [
                P100_JOB_APPLICATION_ID
                " P100_REF_1_NAME"
                " P100_REF_1_PHONE"
                P100_REF_1_EMAIL
                " P100_REF_2_NAME"
                " P100_REF_2_PHONE"
                P100_REF_2_EMAIL
                " P100_REF_3_NAME"
                " P100_REF_3_PHONE"
                P100_REF_3_EMAIL
                " P100_TOKEN"
                " P100_SUBMITTED"
            ]
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }

        column CHANGED_YN (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column CURRENT_VALUE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Current Value
            }
            layout {
                sequence: 30
            }
            sorting {
                sortable: false
            }
        )

        column FIELD_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Field
            }
            layout {
                sequence: 20
            }
            sorting {
                sortable: false
            }
        )

        column NEW_VALUE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Your Value
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="chg-#CHANGED_YN#">#NEW_VALUE#</span>
                    
                    ```
            }
            sorting {
                sortable: false
            }
        )

        column RN (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

    )

    pageItem P101_SUBMITTED (
        type: hidden
        layout {
            sequence: 10
            region: @changes-report
            slot: regionBody
        }
    )

    button cancel-dialog (
        buttonName: CANCEL_DIALOG
        label: Cancel
        layout {
            sequence: 20
            region: @changes-report
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.navigation.dialog.cancel(true);
            }
            execution {
                sequence: 10
            }
        )

    )

    button confirm-submit (
        buttonName: CONFIRM_SUBMIT
        label: Confirm Submit
        layout {
            sequence: 10
            region: @changes-report
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        pkg_ref_correction.save_corrections(
                            p_token       => :P100_TOKEN,
                            p_ref_1_name  => :P100_REF_1_NAME,
                            p_ref_1_phone => :P100_REF_1_PHONE,
                            p_ref_1_email => :P100_REF_1_EMAIL,
                            p_ref_2_name  => :P100_REF_2_NAME,
                            p_ref_2_phone => :P100_REF_2_PHONE,
                            p_ref_2_email => :P100_REF_2_EMAIL,
                            p_ref_3_name  => :P100_REF_3_NAME,
                            p_ref_3_phone => :P100_REF_3_PHONE,
                            p_ref_3_email => :P100_REF_3_EMAIL
                        );
                        :P100_SUBMITTED := 'Y';
                    END;
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

        triggerAction native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    window.parent.location.href = 'f?p=&APP_ID.:100:&APP_SESSION.';
                    
                    
                    ```
            }
            execution {
                sequence: 20
            }
        )

    )

)

