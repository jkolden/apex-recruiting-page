page 9994 (
    name: My Departments
    alias: DEPARTMENTS-LIST
    title: My Departments
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region departments-list (
        name: Departments List
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT department_name,
                       source,
                       scope_detail
                  FROM (
                    SELECT DISTINCT
                           c004          AS department_name,
                           'Assignment'  AS source,
                           NULL          AS scope_detail
                      FROM apex_collections
                     WHERE collection_name = 'FUSION_USER_ASSIGNMENTS'
                       AND c004 IS NOT NULL
                
                    UNION ALL
                
                    SELECT DISTINCT
                           dept_name     AS department_name,
                           'Override'    AS source,
                           CASE
                               WHEN recruiter_id IS NULL AND hiring_mgr_id IS NULL
                                   THEN 'All reqs in dept'
                               WHEN recruiter_id IS NOT NULL AND hiring_mgr_id IS NULL
                                   THEN 'Recruiter-scoped'
                               WHEN recruiter_id IS NULL AND hiring_mgr_id IS NOT NULL
                                   THEN 'Hiring Mgr-scoped'
                               ELSE 'Recruiter + HM scoped'
                           END           AS scope_detail
                      FROM rec_dept_grant
                     WHERE app_user = UPPER(SYS_CONTEXT('APEX$SESSION', 'APP_USER'))
                       AND is_active = 'Y'
                  )
                
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        accessibility {
            landmarkType: region
        }
        componentAppearance {
            display: report
        }
        settings {
            overline: Scope: &SCOPE_DETAIL.
            title: &DEPARTMENT_NAME.
            miscellaneous: &SOURCE.
        }

        column DEPARTMENT_NAME (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: DEPARTMENT_NAME
                dataType: varchar2
            }
        )

        column SCOPE_DETAIL (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SCOPE_DETAIL
                dataType: varchar2
            }
        )

        column SOURCE (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: SOURCE
                dataType: varchar2
            }
        )

    )

)

