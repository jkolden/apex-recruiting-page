        }
    )

    dynamicAction dialog (
        name: dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @submit-corrections
        }

        action native-set-value (
            action: setValue
            settings {
                value: Y
            }
            affectedElements {
                selectionType: items
                items: P100_SUBMITTED
            }
            execution {
                sequence: 10
            }
        )

        action native-submit-page (
            action: submitPage
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    process validate-token-and-load-data (
        name: Validate Token and Load Data
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_app_id   NUMBER;
                    l_name     VARCHAR2(500);
                BEGIN
                    l_app_id := pkg_ref_correction.validate_token(:P100_TOKEN);
                
                    IF l_app_id IS NULL THEN
                        :P100_VALID := 'N';
                        RETURN;
                    END IF;
                
                    :P100_VALID := 'Y';
                    :P100_JOB_APPLICATION_ID := l_app_id;
                
                    -- Get candidate name
                    BEGIN
                        SELECT CANDIDATENAME INTO l_name
                          FROM JOB_APPLICANTS_R
                         WHERE JOBAPPLICATIONID = l_app_id
                           AND ROWNUM = 1;
                        :P100_CANDIDATE_NAME := l_name;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            :P100_CANDIDATE_NAME := 'Applicant';
                    END;
                
                    -- Pre-populate from questionnaire
                    -- Question codes renamed in dev2: GCS_TEACH_REF_* -> GCS_REF_EXT_* / GCS_EXT_REF_*
                    BEGIN
                        SELECT
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_REF_EXT_NAME1'   THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_PHONE1'  THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_REF_EXT_EMAIL1'  THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_NAME2'   THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_PHONE2'  THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_EMAIL2'  THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_NAME3'   THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_PHONE3'  THEN ANSWER_TEXT END),
                            MAX(CASE WHEN QUESTION_CODE = 'GCS_EXT_REF_EMAIL3'  THEN ANSWER_TEXT END)
                        INTO
                            :P100_REF_1_NAME, :P100_REF_1_PHONE, :P100_REF_1_EMAIL,
                            :P100_REF_2_NAME, :P100_REF_2_PHONE, :P100_REF_2_EMAIL,
                            :P100_REF_3_NAME, :P100_REF_3_PHONE, :P100_REF_3_EMAIL
                        FROM FBX_QSTNR_V
                        WHERE SUBJECT_ID = :P100_JOB_APPLICATION_ID
                          AND QUESTION_CODE IN (
                              'GCS_REF_EXT_NAME1','GCS_EXT_REF_PHONE1','GCS_REF_EXT_EMAIL1',
                              'GCS_EXT_REF_NAME2','GCS_EXT_REF_PHONE2','GCS_EXT_REF_EMAIL2',
                              'GCS_EXT_REF_NAME3','GCS_EXT_REF_PHONE3','GCS_EXT_REF_EMAIL3'
                          );
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN NULL;
                    END;
                
                    -- Overlay with any existing corrections
                    BEGIN
                        SELECT
                            COALESCE(ref_1_name,  :P100_REF_1_NAME),
                            COALESCE(ref_1_phone, :P100_REF_1_PHONE),
                            COALESCE(ref_1_email, :P100_REF_1_EMAIL),
                            COALESCE(ref_2_name,  :P100_REF_2_NAME),
                            COALESCE(ref_2_phone, :P100_REF_2_PHONE),
                            COALESCE(ref_2_email, :P100_REF_2_EMAIL),
                            COALESCE(ref_3_name,  :P100_REF_3_NAME),
                            COALESCE(ref_3_phone, :P100_REF_3_PHONE),
                            COALESCE(ref_3_email, :P100_REF_3_EMAIL)
                        INTO
                            :P100_REF_1_NAME, :P100_REF_1_PHONE, :P100_REF_1_EMAIL,
                            :P100_REF_2_NAME, :P100_REF_2_PHONE, :P100_REF_2_EMAIL,
                            :P100_REF_3_NAME, :P100_REF_3_PHONE, :P100_REF_3_EMAIL
                        FROM ref_correction
                        WHERE job_application_id = :P100_JOB_APPLICATION_ID;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN NULL;
                    END;
                
                    -- Format phone numbers and emails
                    :P100_REF_1_PHONE := fmt_phone(:P100_REF_1_PHONE);
                    :P100_REF_2_PHONE := fmt_phone(:P100_REF_2_PHONE);
                    :P100_REF_3_PHONE := fmt_phone(:P100_REF_3_PHONE);
                    :P100_REF_1_EMAIL := LOWER(TRIM(:P100_REF_1_EMAIL));
                    :P100_REF_2_EMAIL := LOWER(TRIM(:P100_REF_2_EMAIL));
                    :P100_REF_3_EMAIL := LOWER(TRIM(:P100_REF_3_EMAIL));
                
                    -- Check which references have already responded to surveys
                    :P100_REF_1_SURVEY_YN := 'N';
                    :P100_REF_2_SURVEY_YN := 'N';
                    :P100_REF_3_SURVEY_YN := 'N';
                
                    BEGIN
                        SELECT
                            NVL(MAX(CASE WHEN LOWER(TRIM(href.REF_EMAIL)) = :P100_REF_1_EMAIL
                                         THEN 'Y' END), 'N'),
                            NVL(MAX(CASE WHEN LOWER(TRIM(href.REF_EMAIL)) = :P100_REF_2_EMAIL
                                         THEN 'Y' END), 'N'),
                            NVL(MAX(CASE WHEN LOWER(TRIM(href.REF_EMAIL)) = :P100_REF_3_EMAIL
                                         THEN 'Y' END), 'N')
                        INTO :P100_REF_1_SURVEY_YN, :P100_REF_2_SURVEY_YN, :P100_REF_3_SURVEY_YN
                        FROM CANDIDATE_REFERENCES href
                        JOIN CANDIDATE_REFERENCE_ANSWERS sa
                            ON sa.SURVEY_TOKEN = href.SURVEY_TOKEN
                        WHERE href.PERSON_ID = (SELECT CANDIDATEPERSONID
                                                FROM JOB_APPLICANTS_R
                                                WHERE JOBAPPLICATIONID = :P100_JOB_APPLICATION_ID
                                                AND ROWNUM = 1);
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN NULL;
