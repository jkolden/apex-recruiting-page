page 100 (
    name: Correct Reference Information
    alias: REF-CORRECT
    title: Correct Reference Information
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function formatPhone(itemName) {
                var raw = apex.item(itemName).getValue().replace(/\D/g, '');
                if (raw.length === 11 && raw[0] === '1') raw = raw.substr(1);
                if (raw.length === 10) {
                    var formatted = '(' + raw.substr(0,3) + ') ' + raw.substr(3,3) + '-' + raw.substr(6);
                    if (formatted !== apex.item(itemName).getValue()) {
                        apex.item(itemName).setValue(formatted, null, true);
                    }
                    $('#' + itemName).closest('.t-Form-fieldContainer').removeClass('phone-invalid').addClass('phone-valid');
                } else if (raw.length === 0) {
                    $('#' + itemName).closest('.t-Form-fieldContainer').removeClass('phone-invalid phone-valid');
                } else {
                    $('#' + itemName).closest('.t-Form-fieldContainer').removeClass('phone-valid').addClass('phone-invalid');
                }
            }
            
            function normalizeEmail(itemName) {
                var v = apex.item(itemName).getValue().trim().toLowerCase();
                if (v !== apex.item(itemName).getValue()) {
                    apex.item(itemName).setValue(v, null, true);
                }
                var container = $('#' + itemName).closest('.t-Form-fieldContainer');
                if (v === '') {
                    container.removeClass('email-invalid email-valid');
                } else if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
                    container.removeClass('email-invalid').addClass('email-valid');
                } else {
                    container.removeClass('email-valid').addClass('email-invalid');
                }
            }
            
            ```
        executeWhenPageLoads:
            ```javascript-browser
            $('[id$="_PHONE"]').on('change blur', function() {
                formatPhone(this.id);
            });
            $('[id$="_EMAIL"]').on('change blur', function() {
                normalizeEmail(this.id);
            });
            
            // Format any pre-populated values
            $('[id$="_PHONE"]').each(function() {
                if (this.value) formatPhone(this.id);
            });
            $('[id$="_EMAIL"]').each(function() {
                if (this.value) normalizeEmail(this.id);
            });
            
            ```
    }
    css {
        inline:
            ```css
            /* ── Page-level styles for reference correction form ── */
            .ref-section {
                border: 1px solid #e0e0e0;
                border-radius: 8px;
                padding: 16px 20px;
                margin-bottom: 16px;
                background: #fafafa;
            }
            .ref-section h3 {
                margin: 0 0 12px 0;
                font-size: 15px;
                color: #333;
            }
            .page-header-text {
                font-size: 16px;
                color: #555;
                margin-bottom: 24px;
                line-height: 1.5;
            }
            .expired-message {
                text-align: center;
                padding: 60px 20px;
            }
            .expired-message .fa {
                font-size: 48px;
                color: #cc4444;
                margin-bottom: 16px;
            }
            .success-message {
                text-align: center;
                padding: 60px 20px;
            }
            .success-message .fa {
                font-size: 48px;
                color: #2c5f2d;
                margin-bottom: 16px;
            }
            /* Hide navigation on public page */
            .t-Header-nav-list, .t-TreeNav {
                display: none !important;
            }
            
            /* Hide entire header/nav on public page */
            .t-Header, .t-Body-nav, .t-TreeNav {
                display: none !important;
            }
            .t-Body-content {
                margin-left: 0 !important;
            }
            .t-Body {
                padding-top: 0 !important;
            }
            
            
            #refConfirmDlg {
                padding: 16px 20px;
                overflow: visible;
            }
            .ui-dialog:has(#refConfirmDlg) {
                max-height: 80vh;
            }
            .ui-dialog:has(#refConfirmDlg) .ui-dialog-content {
                max-height: none !important;
                overflow: visible !important;
            }
            
            .phone-valid .apex-item-text,
            .email-valid .apex-item-text {
                border-color: #16a34a !important;
                box-shadow: 0 0 0 1px #16a34a inset;
            }
            .phone-invalid .apex-item-text,
            .email-invalid .apex-item-text {
                border-color: #dc2626 !important;
                box-shadow: 0 0 0 1px #dc2626 inset;
            }
            
            .display_only a {
                pointer-events: none;
                color: inherit;
                text-decoration: none;
            }
            
            ```
    }
    security {
        authentication: public
        formAutoComplete: false
    }
    comments {
        comments:
            ```
            CONFIRMATION MODAL (Page 101) — Implementation Notes
            =====================================================
            Page 100 submits (saving form values to session state) and branches
            to page 101 (Modal Dialog), which opens as an overlay.
            
            Page 101 shows a classic report comparing database originals vs the
            user's edits (read from P100_* session state). The Confirm button
            uses a Dynamic Action (NOT Submit Page):
              - True Action 1: Server-side PL/SQL calls save_corrections and
                sets P100_SUBMITTED = 'Y' in session state
              - True Action 2: JavaScript redirects the parent window:
                window.parent.location.href = 'f?p=&APP_ID.:100:&APP_SESSION.';
            
            The dialog iframe dies when the parent navigates. Page 100 reloads,
            Before Header sees P100_SUBMITTED = 'Y', and the Thank You region
            displays.
            
            APEX GOTCHAS (discovered during build):
              - Dialog Closed DA does NOT fire when dialog was opened via branch
              - apex.navigation.dialog() requires a server-generated checksum
              - Close Dialog process closes the modal but can't trigger parent DA
              - Passing items in f?p URL triggers checksum errors even with
                Unrestricted page protection — set session state via PL/SQL
                instead and redirect with a clean URL (no item params)
              - P100_SUBMITTED must have Session State Protection = Unrestricted
            
            ```
    }

    region correct-your-reference-information (
        name: Correct Your Reference Information
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        headerAndFooter {
            headerText:
                ```html
                <div class="page-header-text">
                    Hello <strong>&P100_CANDIDATE_NAME.</strong>, please review the reference
                    contact information below. Correct any errors and click
                    <strong>Submit Corrections</strong>.
                </div>
                ```
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P100_VALID = 'Y' AND NVL(:P100_SUBMITTED,'N') != 'Y'
        }
    )

