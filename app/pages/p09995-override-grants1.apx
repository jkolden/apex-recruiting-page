    css {
        inline:
            ```css
            #t_Button_navControl {
                display: none !important;
            }
            
            /* Breadcrumb container */
            #gps-breadcrumb {
              background: #fff;
              border: 0;
              border-bottom: 1px solid #dfe6e2;
              box-shadow: none;
            }
            
            #gps-breadcrumb .t-ButtonRegion-wrap {
              min-height: auto;
              padding: 10px 24px;
            }
            
            /* Remove unused columns */
            #gps-breadcrumb .t-ButtonRegion-col--left,
            #gps-breadcrumb .t-ButtonRegion-col--right {
              display: none;
            }
            
            /* Breadcrumb layout */
            #gps-breadcrumb .t-Breadcrumb {
              margin: 0;
              padding: 0;
            }
            
            /* Home link */
            #gps-breadcrumb .t-Breadcrumb-item a.t-Breadcrumb-label,
            #gps-breadcrumb .t-Breadcrumb-item a.t-Breadcrumb-label:visited {
              color: #315c45;
              font-size: 0.9375rem;
              font-weight: 600;
              text-decoration: none;
            }
            
            #gps-breadcrumb .t-Breadcrumb-item a.t-Breadcrumb-label:hover {
              color: #244735;
              text-decoration: underline;
            }
            
            /* Current page */
            #gps-breadcrumb .t-Breadcrumb-item.is-active .t-Breadcrumb-label {
              margin: 0;
              color: #1f2933;
              font-size: 0.9375rem;
              font-weight: 700;
              line-height: 1.4;
            }
            
            /* Divider between breadcrumb items */
            #gps-breadcrumb .t-Breadcrumb-item::after {
              color: #a5afa9;
              font-weight: 400;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: gps-breadcrumb
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region override-grants (
        name: Override Grants
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT g.id,
                       g.app_user,
                       g.dept_name,
                       case when  g.is_active = 'Y' then 'fa fa-check' end as is_active,
                       rec_emp.DISPLAY_NAME                                                 AS recruiter_name,
                       g.recruiter_id,
                       hm_emp.DISPLAY_NAME                                                  AS hiring_manager_name,
                       g.hiring_mgr_id,
                       CASE
                           WHEN g.recruiter_id IS NULL AND g.hiring_mgr_id IS NULL
                               THEN 'All reqs in dept'
                           WHEN g.recruiter_id IS NOT NULL AND g.hiring_mgr_id IS NULL
                               THEN 'Recruiter: ' || rec_emp.DISPLAY_NAME
                           WHEN g.recruiter_id IS NULL AND g.hiring_mgr_id IS NOT NULL
                               THEN 'Hiring Mgr: ' || hm_emp.DISPLAY_NAME
                           ELSE 'Recruiter: ' || rec_emp.DISPLAY_NAME
                             || ' OR Hiring Mgr: ' || hm_emp.DISPLAY_NAME
                       END                                                                  AS access_summary,
                       g.granted_by,
                       g.granted_ts,
                       g.notes
                  FROM rec_dept_grant g
                  LEFT JOIN FBX_HCM_EMPLOYEE rec_emp ON rec_emp.PERSON_ID = g.recruiter_id
                  LEFT JOIN FBX_HCM_EMPLOYEE hm_emp  ON hm_emp.PERSON_ID  = g.hiring_mgr_id
                 ORDER BY g.app_user, g.dept_name;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
