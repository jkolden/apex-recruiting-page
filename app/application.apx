app FA_INTEG_IBZSJB_TEST (
    name: Recruiting Application
    logo {
        type: text
        text: Greenville County Schools
    }
    navigation {
        homeUrl: {
            page: 24
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @apex-fa-ibzsjb-dev2-oauth
        publicUser: APEX_PUBLIC_USER
    }
    security {
        deepLinking: true
        embedInFrames: allow
    }
    sessionStateProtection {
        checksumSalt: 640872007E21CDF7761316FA8FE6C122DC6A2ADADB2A0E328F8301DE4C0A8358
    }
    sessionManagement {
        sessionTimeoutUrl: f?p=154:1:0
        sessionIdleTimeoutUrl: f?p=154:1:0
    }
    runtime {
        friendlyUrls: false
        allowFeedback: true
        compatibilityMode: 24.2
    }

    substitution APP_NAME (
        value {
            staticValue: Fusion Integrated Sample App (ibzsjb-test)
        }
    )

    appSetting BICC_FUSION_PASSWORD (
        value {
            staticValue: Gcsd*#SC543!
            onUpgradeKeepValue: true
        }
    )

    appSetting BICC_FUSION_USERNAME (
        value {
            staticValue: gcs_reports
            onUpgradeKeepValue: true
        }
    )

)

