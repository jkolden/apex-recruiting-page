authentication apex-fa-ibzsjb-test-oauth (
    name: APEX_FA_IBZSJB-TEST_OAUTH
    type: socialSignIn
    settings {
        credentialStore: @APEX_FA_IBZSJB_TEST_DBMS_CRED
        discoveryUrl: #FA_IBZSJB-TEST_DISCOVERY_URL#
        scope: profile,email,offline_access,#FA_IBZSJB-TEST_OAUTH_SCOPE#
        username: #sub#
    }
    loginProcessing {
        postAuthenticationProcedureName: pkg_app_security.login_role_check
    }
    comments {
        comments: Created for federated authentication with the ibzsjb-test Fusion instance.
    }
)

authentication oracle-apex-accounts (
    name: Oracle APEX Accounts
    type: oracleApexAccounts
)

authentication session-verify-only (
    name: SESSION_VERIFY_ONLY
    type: custom
    settings {
        sentryFunctionName: my_sentry
        invalidSessionProcedureName: invalid_session_redirect
        authFunctionName: never_authenticate
    }
    source {
        plsqlCode:
            ```plsql
            procedure invalid_session_redirect is
            begin
                owa_util.redirect_url('f?p=154:1');
                apex_application.stop_apex_engine;
            end;
            
            function never_authenticate (
                p_username in varchar2,
                p_password in varchar2
            ) return boolean is
            begin
                return false;
            end;
            
            function my_sentry return boolean is
            begin
                return apex_custom_auth.is_session_valid;
            end;
            
            ```
    }
)

