authentication apex-fa-ibzsjb-dev2-oauth (
    name: APEX_FA_IBZSJB-DEV2_OAUTH
    type: socialSignIn
    settings {
        credentialStore: @APEX_FA_IBZSJB_DEV2_DBMS_CRED
        discoveryUrl: #FA_IBZSJB-DEV2_DISCOVERY_URL#
        scope: profile,email,offline_access,#FA_IBZSJB-DEV2_OAUTH_SCOPE#
        username: #sub#
    }
    postLogout {
        redirectTo: url
        url: f?p=154:1
    }
    sessionSharing {
        type: custom
        cookieName: DEV2
    }
    comments {
        comments: Created for federated authentication with the ibzsjb-dev2 Fusion instance.
    }
)

