authorization administration-rights (
    name: Administration Rights
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return true;
    }
    error {
        errorMessage: Insufficient privileges, user is not an Administrator
    }
)

authorization is-admin (
    name: IS_ADMIN
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return pkg_app_security.is_admin(:APP_USER);
    }
    error {
        errorMessage: You are not authorized to access this page. Please contact your administrator for access.
    }
    advanced {
        evaluationType: perSession
    }
)

authorization is-hiring-manager (
    name: IS_HIRING_MANAGER
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return pkg_app_security.is_hiring_manager;
    }
    error {
        errorMessage: You don't have authorization to access this page based on your assigned roles
    }
    advanced {
        evaluationType: perSession
    }
)

authorization is-recruiting-mgr (
    name: IS_RECRUITING_MGR
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return pkg_app_security.is_recruiting_mgr;
    }
    error {
        errorMessage: You are not authorized to access this page. Contact your administrator for access.
    }
    advanced {
        evaluationType: perSession
    }
)

