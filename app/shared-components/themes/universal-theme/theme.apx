theme universal-theme (
    name: Universal Theme
    themeNumber: 42
    baseTheme: ut-26.1
    style {
        currentThemeStyle: @/iris
    }
    javaScript {
        fileUrls: [
            #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.stickyWidget#MIN#.js?v=#APEX_VERSION#
            #THEME_FILES#js/theme42#MIN#.js?v=#APEX_VERSION#
        ]
    }
    css {
        fileUrls: #THEME_FILES#css/Core#MIN#.css?v=#APEX_VERSION#
    }
    componentDefaults {
        page: @/standard
        navigationBarList: @/navigation-bar
        navigationMenuListPosition: side
        navigationMenuListTop: @/top-navigation-menu
        navigationMenuListSide: @/side-navigation-menu
        loginPage: @/login
        errorPage: @/login
        printerFriendlyPage: @/standard
        breadcrumb: @/breadcrumb
        button: @/text
        defaultLabel: @/optional-floating
        optionalLabel: @/optional-floating
        requiredLabel: @/required-floating
        list: @/links-list
        region: @/standard
        classicReport: @/standard
    }
    regionDefaults {
        breadcrumbs: @/title-bar
        charts: @/standard
        forms: @/standard
        lists: @/standard
        reports: @/standard
        wizards: @/standard
        interactiveReports: @/interactive-report
    }
    dialogDefaults {
        dialogContentRegion: @/blank-with-attributes
        dialogButtonRegion: @/buttons-container
        dialogPage: @/modal-dialog
    }
    icons {
        library: fontApex
    }
    advanced {
        filePrefix: #APEX_FILES#themes/theme_42/26.1/
        identifier: UNIVERSAL_THEME
    }

    style redwood-light-copy (
        name: Redwood Light Copy 1
        css {
            fileUrls: [
                #APEX_FILES#libraries/oracle-fonts/oraclesans-apex#MIN#.css?v=#APEX_VERSION#
                #THEME_FILES#css/Redwood#MIN#.css?v=#APEX_VERSION#
            ]
        }
        themeRollerAttributes {
            inputParameterFileUrls: #THEME_FILES#less/theme/Redwood-Theme.less
            outputCssFileUrl: #THEME_DB_FILES#45121321815189899.css
            jsonConfig: "{\"classes\":[],\"vars\":{},\"customCSS\":\"/* APEX 24.2 / Oracle JET chart palette overrides (Redwood-ish) */\\n:root{\\n  /* Most common JET DVT variables */\\n  --oj-dvt-category1-color:  #C74634; /* Oracle red */\\n  --oj-dvt-category2-color:  #1B6B76; /* deep teal */\\n  --oj-dvt-category3-color:  #D99A2B; /* amber */\\n  --oj-dvt-category4-color:  #5B6770; /* slate */\\n  --oj-dvt-category5-color:  #6E4B8B; /* purple */\\n  --oj-dvt-category6-color:  #2E7D32; /* green */\\n  --oj-dvt-category7-color:  #8C3A2B; /* brick */\\n  --oj-dvt-category8-color:  #7A8A97; /* blue-gray */\\n  --oj-dvt-category9-color:  #B23A48;\\n  --oj-dvt-category10-color: #0F4C5C;\\n  --oj-dvt-category11-color: #B07C2C;\\n  --oj-dvt-category12-color: #3E4C59;\\n\\n  /* Some builds use RGB palette tokens instead (harmless to include) */\\n  --oj-palette-dvt-rgb-1:  199, 70, 52;\\n  --oj-palette-dvt-rgb-2:  27, 107, 118;\\n  --oj-palette-dvt-rgb-3:  217, 154, 43;\\n  --oj-palette-dvt-rgb-4:  91, 103, 112;\\n  --oj-palette-dvt-rgb-5:  110, 75, 139;\\n  --oj-palette-dvt-rgb-6:  46, 125, 50;\\n}\\n\",\"useCustomLess\":\"N\"}"
        }
        advanced {
            endUserCanPick: true
        }
    )

)

