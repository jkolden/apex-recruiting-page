            }
        }
    )

)

list recruiting-rest-refresh-options (
    name: Recruiting REST Refresh Options

    entry full (
        label: Full
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: javascript:refreshRecruiting('FULL')
            }
        }
    )

    entry incremental-past-4-hours (
        label: incremental (Past 4 hours)
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url:
                    ```
                    javascript:refreshRecruiting('INCREMENTAL')
                    
                    ```
            }
        }
    )

)

